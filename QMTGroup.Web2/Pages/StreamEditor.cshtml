@page
@model StreamEditorModel
@{
    ViewData["Title"] = "Stream editor";
}
@section Scripts{

}
<style>
    .resizable {
        width: 200px;
        height: 150px;
        overflow: auto; /* nécessaire pour resize */
        resize: horizontal; /* permet de redimensionner horizontalement */
        border-right: 10px solid #333;
    }

    .border-wrapper {
        width: 300px;
        height: 200px;
        overflow: auto; /* nécessaire pour resize */
        resize: horizontal; /* permet le redimensionnement */
        border: 10px solid #333;
        box-sizing: border-box;
        cursor: ew-resize; /* curseur sur toute la bordure */
        padding: 0; /* le contenu reste à l’intérieur */
    }

    .content {
        width: 100%;
        height: 100%;
        background: #f9f9f9;
        pointer-events: none; /* pour que seul le wrapper capture le drag */
    }

</style>
<div class="border-wrapper">
    <div class="content">
        Contenu non redimensionnable
    </div>
</div>


<div class="d-flex flex-row w-100 h-100 align-content-stretch flex-nowrap">
    <div class="resizable" style="background-color:red;min-width:20px; min-height:40px;">
        <h2>Mon element #1</h2>
    </div>
    <div class="" style="background-color:orange;min-width:160px; min-height:90px;">
        <h2>Element principal</h2>
    </div>
</div>
    <!-- CURVE FILTER : MODAL -->
    <script>
        function drawCurve() {
            const canvas = document.getElementById("gaussCanvas");
            const ctx = canvas.getContext("2d");

            // Efface le canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const sigma = parseFloat(document.getElementById("sigma").value);
            const mean = 0; // Moyenne
            const width = canvas.width;
            const height = canvas.height;

            // Échelle
            const scaleX = 50; // pixels par unité
            const scaleY = 200; // pixels pour la hauteur max

            // Fonction de densité de probabilité de Gauss
            function gaussian(x, mean, sigma) {
                return (1 / (sigma * Math.sqrt(2 * Math.PI))) * Math.exp(-((x - mean) ** 2) / (2 * sigma ** 2));
            }

            // Tracer les axes
            ctx.beginPath();
            ctx.moveTo(0, height);
            ctx.lineTo(width, height); // Axe X
            ctx.moveTo(width / 2, 0);
            ctx.lineTo(width / 2, height); // Axe Y
            ctx.strokeStyle = "#333";
            ctx.stroke();

            // Dessiner la courbe de Gauss
            ctx.beginPath();
            ctx.strokeStyle = "blue";
            ctx.lineWidth = 2;

            for (let x = -8 * sigma; x <= 8 * sigma; x += 0.01) {
                const px = width / 2 + x * scaleX;
                const py = height - gaussian(x, mean, sigma) * scaleY;

                if (x === -8 * sigma) {
                    ctx.moveTo(px, py);
                } else {
                    ctx.lineTo(px, py);
                }
            }
            ctx.stroke();
        }

        document.getElementById("sigma").oninput = function(){
            this.nextElementSibling.value = this.value;
            drawCurve();
        }

        drawCurve();
    </script>

    <!-- STREAM MANAGEMENT -->
    <script>
        let cameraStarted = false;
        var guid = "bda3b6e6-45eb-4c6d-b1a4-82dccdc88fe7";

        document.getElementById("ONOFF").onclick = function(e){

            document.getElementById("ONOFF").disabled = true;
            if(cameraStarted){
                $.ajax({
                    url: "https://localhost:7083/api/videoStream/stop?cameraInstance="+guid,
                    type: 'POST',
                    success: function(){
                        cameraStarted = false;
                        imageOverlay.setOpacity(0);
                        document.getElementById("ONOFF").disabled = false;
                        document.getElementById("ONOFF").className = "btn btn-primary mb-1 w-100 text-start";
                        document.getElementById("ONOFF").innerHTML = "Démarrer";
                    },
                    error: function(){
                        document.getElementById("ONOFF").disabled = false;
                    }
                });
            }else{
                $.ajax({
                    url: "https://localhost:7083/api/videoStream/start?cameraInstance="+guid,
                    type: 'POST',
                    success: function(){
                        cameraStarted = true;
                        imageOverlay.setOpacity(1);
                        document.getElementById("ONOFF").disabled = false;
                        document.getElementById("ONOFF").className = "btn btn-danger mb-1 w-100 text-start";
                        document.getElementById("ONOFF").innerHTML = "Stop";
                    },
                    error: function(){
                        document.getElementById("ONOFF").disabled = false;
                    }
                });
            }
        };
    </script>


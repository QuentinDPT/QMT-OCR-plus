            <div class="w-100" style="aspect-ratio: 640/480;">
                <div id="map" style="width:100%;height:100%"></div>
            </div>
            <p><span id="LastFrame"></span> fps</p>
        </div>
        <div class="col-12 col-lg-3">
            <div class="d-flex flex-column">
                <h1>Filtres</h1>
                <table>
                    <thead></thead>
                    <tbody>
                        <tr>
                            <td>
                                <button id="ONOFF" class="btn btn-primary mb-1 w-100 text-start">Démarrer/Arreter</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <button id="STD" class="btn btn-outline-secondary mb-1 w-100 text-start">Source</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <button id="MD1" class="btn btn-outline-secondary mb-1 w-100 text-start">Nuances de gris</button>
                            </td>
                        </tr>
                        <tr>
                            <td class="d-flex">
                                <button id="MD2" class="btn btn-outline-secondary w-100 text-start">Filtre gaussien</button>
                                <button id="MD2-param" class="btn btn-outline-secondary" data-toggle="modal" data-target=".bd-example-modal-sm">⚙️</button>
                            </td>
                        </tr>
                    </tbody>

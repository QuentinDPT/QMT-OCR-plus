@page
@model PrivacyModel
@{
    ViewData["Title"] = "Configuration";
}
@section Scripts {
    <script>
        async function fetchData() {
            // Récupérer les données de la première requête AJAX
            const response = await fetch("/api/videostream/allcamera");
            const cameras = await response.json();

            // Initialiser la variable pour afficher les résultats
            let str = "";

            // Parcourir chaque caméra
            for (const [key, value] of Object.entries(cameras)) {
                // Ajouter les informations de la caméra dans le champ de texte
                str += `${value}\t${key}\n`;

                // Récupérer les détails de chaque caméra
                const cameraDetailsResponse = await fetch(`/api/videostream/camera?cameraInstance=${key}`);
                const cameraDetails = await cameraDetailsResponse.json();
                console.log(cameraDetails);

                // Ajouter les détails de la caméra dans le champ de texte
                str += JSON.stringify(cameraDetails, null, 2) + "\n";
            }

            // Mettre à jour le champ de texte une fois que tout est récupéré
            document.getElementById("ConfigResult").value = str;
        }
        fetchData();
    </script>
}

<h1>@ViewData["Title"]</h1>

<textarea class="w-100" style="height:75vh" id="ConfigResult"></textarea>

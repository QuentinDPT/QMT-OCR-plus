@page "{ressource?}"
@model QMTGroup.Web.Pages.CodeModel
@{
    ViewData["Title"] = "Code";
}

@if (string.IsNullOrEmpty(Model.Ressource))
{

    @section Scripts {
        <script>
            function addCode(title, description) {
                const template = document.getElementById('code-item-template');
                const list = document.getElementById('code-list');

                // Clone du template
                const clone = template.content.cloneNode(true);

                // Bind des données
                clone.querySelector('.item-title').textContent = title;
                if(description == "")
                    clone.querySelector('.item-description').style = "display: none;";
                else
                    clone.querySelector('.item-description').textContent = description;

                // Bouton edit
                clone.querySelector('.btn-edit').onclick = () => {
                    window.location = `/Code/${title}`;
                };

                // Bouton delete
                clone.querySelector('.btn-delete').onclick = () => {
                    $.ajax({
                        url: 'api/code',
                        type: 'DELETE',
                        contentType: 'application/json',
                        data: JSON.stringify(title),
                        success: function (response) {
                            window.location = window.location;
                        },
                        error: function (error) {
                            console.error('GET Error:', error);
                        }
                    });
                };

                list.appendChild(clone);
            }

            $.ajax({
                url: 'api/code',
                type: 'GET',
                success: function (response) {
                    console.log(response);

                    for(const i of response){
                        addCode(i.title, i.description);
                    }
                },
                error: function (error) {
                    console.error('GET Error:', error);
                }
            });

            function createNewCode() {
                var codeName = document.getElementById("addCodeName").value;

                if(codeName == ""){
                    console.error("Can'this add an empty code name.");
                    return;
                }

                $.ajax({
                    url: 'api/code',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(codeName),
                    success: function (response) {
                        window.location = "/Code/" + codeName ;
                    },
                    error: function (error) {
                        console.error('GET Error:', error);
                    }
                });
            }

            document.getElementById("addNewCodeButton").onclick = createNewCode;
        </script>

    }


    <h2>Scripts</h2>
    <p>Code lua</p>

    <div>
        <button class="btn btn-outline-primary rounded-pill" onclick="window.location = `vscode://file/@Model.DirectoryLocation`;">
            <img style="height:24px; transform: scale(.75);" src="/img/vscode-icon.svg" />
        </button>
        <button class="btn btn-outline-primary rounded-pill" onclick="window.location = `vscodium://file/@Model.DirectoryLocation`;">
            <img style="height:24px; transform: scale(.75);" src="/img/codium-icon.png" />
        </button>
    </div>

    <template id="code-item-template">
        <li style="background:#eee" class="list-group-item d-flex justify-content-between m-1">
            <div class="d-flex flex-column justify-content-around">
                <h5 class="item-title m-0"></h5>
                <small class="item-description p-left-3"></small>
            </div>

            <div class="d-flex">
                <button class="btn btn-secondary m-1 btn-edit">
                    <span class="material-symbols-outlined">edit</span>
                </button>

                <div class="dropdown m-1">
                    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="material-symbols-outlined">more_horiz</span>
                    </button>

                    <div class="dropdown-menu">
                        <div class="dropdown-item d-flex additional-info">
                            <span class="material-symbols-outlined">download</span>
                            <span>Download</span>
                        </div>

                        <div class="dropdown-item d-flex additional-info btn-delete">
                            <span class="material-symbols-outlined">delete</span>
                            <span>Supress</span>
                        </div>

                        <div class="dropdown-item d-flex additional-info">
                            <span class="material-symbols-outlined">info</span>
                            <span>Informations</span>
                        </div>
                    </div>
                </div>
            </div>
        </li>
    </template>
    <ul id="code-list" class="list-group list-group-flush">
    </ul>
    <input type="text" id="addCodeName" />
    <button type="button" class="btn btn-primary" id="addNewCodeButton">
        <span class="material-symbols-outlined">add</span>
    </button>
}
else
{
    @section Styles {
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.css">

        <style>
            #editor {
                border: 1px solid #ccc;
                min-height: 10ch;
            }

            .annotation {
                background: #eff; /* Light yellow background */
                border-left: 4px solid #0cf; /* Orange left border */
                padding: 2px 8px;
                margin: 2px 0;
                font-size: 12px;
            }

            .CodeMirror {
                height: 100% !important;
            }

        </style>
        <style>
            .CodeMirror-gutters {
                background: #f5f5f5;
                border-right: 1px solid #ddd;
            }

            .CodeMirror-linenumber {
                color: #888;
            }

            .custom-gutter {
                width: 22px;
            }

            .custom-marker {
                color: #888;
                text-align: end;
            }

            .info-panel {
                width: 200px;
                border: 1px solid #ddd;
                background: #f9f9f9;
                border-left: none;
                position: relative;
            }

                .info-panel > * {
                    height: 24px;
                    background: purple;
                }
        </style>
        <style>
            #scriptLogResultArea > * {
                padding-left: .8em;
            }

            #executionButton {
                color: green;
            }

                #executionButton:disabled {
                    color: gray;
                }

            #stopButton {
                color: red;
            }

                #stopButton:disabled {
                    color: gray;
                }

            .log-Trace {
                color: gray;
            }

            .log-Debug {
                color: deepskyblue;
            }

            .log-Information {
                color: black;
            }

            .log-Error, .log-Critical {
                background: red;
                color: white;
            }

            .log-Critical {
                font-weight: bold;
            }

            .log-Warning {
                color: orange;
            }

        </style>
    }
    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/lua/lua.js"></script>

        <!-- AUTOMATIC SAVES -->
        <script>
            var codeMemory = "";

            var actualCodeRequirements = [];

            function saveCode(){
                let codeStr = editor.getValue();

                if(codeStr == codeMemory && !codeHasChanged)
                    return;

                codeMemory = codeStr;
                codeHasChanged = false;

                $.ajax({
                    url: 'api/code/' + documentName, // API endpoint
                    type: 'POST', // Méthode HTTP POST
                    data: JSON.stringify(codeStr), // Convertir le contenu en JSON
                    contentType: 'application/json; charset=UTF-8', // Type de contenu
                    success: function(response) {
                        console.log('Code sauvegardé avec succès:', response);
                    },
                    error: function(error) {
                        console.error('Erreur lors de la sauvegarde du code:', error);
                    }
                });

                codeLines = codeStr.split('\n')

                // Sauvegarder la position de défilement actuelle
                const scrollInfo = editor.getScrollInfo();

                var requirementList = [];

                clearAnnotations();

                for (let i = 0; i < codeLines.length; i++) {
                    const obj = codeLines[i];

                    const functionRegex = /function\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\(/;

                    const match = obj.match(functionRegex);

                    if(match){
                        if(!match[1].startsWith("_"))
                            addAnnotation(i, documentName + "." + match[1])
                    }

                    const requireRegex = /^require\ ([a-zA-Z]+[a-zA-Z0-9_\.]*)\ *(\ +--.*)*$/
                    const matchReq = obj.match(requireRegex);

                    if(matchReq){
                        if(!requirementList.includes(matchReq[1]))
                            requirementList.push(matchReq[1]);
                    }
                }

                if(JSON.stringify(actualCodeRequirements) != JSON.stringify(requirementList)) {
                    personnalKeywords = [];
                    for(let i of requirementList){
                        $.ajax({
                            url: 'api/codeextention/' + i, // API endpoint
                            type: 'GET', // Méthode HTTP POST
                            contentType: 'application/json; charset=UTF-8', // Type de contenu
                            success: function(response) {
                                personnalKeywords = personnalKeywords.concat(response.map(x => i + "." + x));
                            },
                            error: function(error) {
                                console.error('Erreur lors du chargement de l\'extention ' + i + ' : ', error);
                            }
                        });
                    }
                    actualCodeRequirements = requirementList
                }

                // Restaurer la position de défilement
                editor.scrollTo(scrollInfo.left, scrollInfo.top);
            }
        </script>

        <script>
            document.addEventListener('keydown', function(event) {
                if (event.ctrlKey && event.key === 'Enter') {
                    executeCode();
                }

                if (event.ctrlKey && event.key === 's') {
                    event.preventDefault();

                    saveCode();
                }
            });

            document.getElementById("stopButton").disabled = true;
            var documentName = "@Model.Ressource";
            var codeHasChanged = false;

            document.addEventListener('DOMContentLoaded', function () {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl, {
                        delay: { "show": 1000, "hide": 100 } // 500ms pour apparaître, 100ms pour disparaître
                    });
                });
            });


            var logResultArea = document.getElementById("scriptLogResultArea");
            logResultArea.innerHTML = "";

            document.getElementById("docName").addEventListener("input", function(event) {
              documentName = event.target.value;
              codeHasChanged = true;
            });
            document.getElementById("docName").value = documentName;

            const luaKeywords = [
                "and", "break", "do", "else", "elseif", "end", "false",
                "for", "function", "if", "in", "local", "nil", "not",
                "or", "repeat", "return", "then", "true", "until", "while",
                "print", "pairs", "ipairs", "math", "table", "string", "require"
            ];

            function addGutterMarker(line, text) {
                var marker = document.createElement("div");
                marker.className = "custom-marker";
                marker.innerHTML = text;
                editor.setGutterMarker(line, "custom-gutter", marker);
            }

            function clearGutterMarker(){
                editor.clearGutter("custom-gutter");
            }

            function executeCode(){
                document.getElementById("executionButton").disabled = true;

                saveCode();

                clearGutterMarker();

                document.getElementById("infoPanel").innerHTML = "";

                logResultArea.innerHTML = "";

                for(let i = 0; i < editor.lineCount() ; i++){
                    document.getElementById("infoPanel").innerHTML += "<div data-toggle=\"tooltip\" data-placement=\"top\" style='width:0'></div>";
                }

                const controller = new AbortController();


                function requestEnded() {
                    document.getElementById("executionButton").disabled = false;

                    document.getElementById("stopButton").disabled = true;
                    document.getElementById("stopButton").onclick = function(){};
                }

                document.getElementById("stopButton").onclick = function(){
                    controller.abort();
                    requestEnded();
                };
                document.getElementById("stopButton").disabled = false;

                fetch('api/code/execute/' + documentName, {
                    method: 'GET',
                    signal: controller.signal
                })
                .then(response => {
                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = '';

                    function read() {
                        reader.read().then(({ done, value }) => {
                            if (done) {
                                requestEnded();
                                return;
                            }

                            buffer += decoder.decode(value, { stream: true });

                            let lines = buffer.split(',\n');
                            buffer = lines.pop(); // conserve la ligne incomplète

                            for (let line of lines) {
                                if (line.trim() === '') continue;

                                try {
                                    const obj = JSON.parse(line);
                                    if (obj.type === "log") {
                                        const p = document.createElement("div");
                                        p.innerHTML = decodeHtmlEntity(obj.message);
                                        p.className = "log-" + obj.logType;
                                        p.style = "display:flex;";
                                        logResultArea.appendChild(p);
                                    }
                                } catch (e) {
                                    console.error("Erreur de JSON : ", e, line);
                                }
                            }

                            scrollElementToBottom(logResultArea.parentElement);
                            read(); // continuer
                        });
                    }

                    read();
                })
                .catch(err => {
                    console.error(err);
                    const p = document.createElement("div");
                    p.textContent = err.message;
                    p.className = "log-Critical";
                    logResultArea.appendChild(p);
                    requestEnded();
                });
            }

            function decodeHtmlEntity(str) {
              let txt = document.createElement("textarea");
              txt.innerHTML = str;
              return txt.value;
            }

            function scrollElementToBottom(element, smooth = true) {
                element.scrollTo({
                    top: element.scrollHeight,
                    behavior: smooth ? 'smooth' : 'auto'
                });
            }

            document.getElementById("executionButton").onclick = executeCode;

            var personnalKeywords = [ ];

            function luaHint(editor) {
                const cursor = editor.getCursor();
                const token = editor.getTokenAt(cursor);
                const start = token.start;
                const end = cursor.ch;
                const currentWord = token.string;

                const suggestions = [...luaKeywords, ...personnalKeywords].filter(kw => kw.startsWith(currentWord) && kw != currentWord);

                return {
                    list: suggestions,
                    from: CodeMirror.Pos(cursor.line, start),
                    to: CodeMirror.Pos(cursor.line, end)
                };
            }

            const editor = CodeMirror(document.getElementById('editor'), {
                mode: 'text/x-lua',
                lineNumbers: true,
                indentWithTabs: true,
                tabSize: 4,
                gutters: ["CodeMirror-linenumbers", "custom-gutter"],
                theme: 'default',
                extraKeys: {
                    "Ctrl-Space": "autocomplete"
                }
            });

            CodeMirror.registerHelper("hint", "lua", luaHint);

            editor.on("inputRead", function onInput(editor, event) {
                if (!editor.state.completionActive && event.text.length === 1) {
                    editor.showHint({
                        hint: CodeMirror.hint.lua,
                        completeSingle: false // Désactive l'acceptation automatique
                    });
                }
            });

            // Tableau pour stocker les widgets (annotations de type "line widget")
            const annotationWidgets = [];

            // Fonction pour ajouter une annotation
            function addAnnotation(line, text, above = true, className = "") {
                // Sauvegarder la position de défilement actuelle
                const scrollInfo = editor.getScrollInfo();

                // Créer l'annotation
                const annotation = document.createElement('div');
                annotation.className = 'annotation ' + className;
                annotation.textContent = text;

                // Ajouter le widget
                const widget = editor.addLineWidget(line, annotation, { above: above });
                annotationWidgets.push(widget);

                // Restaurer la position de défilement
                editor.scrollTo(scrollInfo.left, scrollInfo.top);
            }

            function clearAnnotations() {
                // Sauvegarder la position de défilement actuelle
                const scrollInfo = editor.getScrollInfo();

                while (annotationWidgets.length > 0) {
                    const widget = annotationWidgets.pop(); // Retirer chaque widget
                    widget.clear(); // Supprimer l'annotation
                }

                // Restaurer la position de défilement
                editor.scrollTo(scrollInfo.left, scrollInfo.top);
            }
        </script>

        <!-- FETCH CODE -->
        <script>
            $.ajax({
                url: 'api/code/' + documentName, // API endpoint
                type: 'GET', // HTTP method
                success: function (response) {
                    editor.setValue(response);
                },
                error: function (error) {
                    console.error('GET Error:', error.responseText); // Logs any error
                }
            });
        </script>
    }
    <div>
        <div class="position-sticky top-0" style="z-index:3; background:white;">
            <div class="d-flex">
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center" style="color:gray">
                    <span class="material-symbols-outlined">drag_indicator</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Revenir à l'explorateur de scripts">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center"
                        id="executionButton"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Executer (Ctrl + Enter)">
                    <span class="material-symbols-outlined">play_arrow</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center" id="stopButton">
                    <span class="material-symbols-outlined">stop</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center" style="color:black">
                    <span class="material-symbols-outlined">terminal</span>
                </button>

                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center">
                    <span class="material-symbols-outlined">search</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center">
                    <span class="material-symbols-outlined">home</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center">
                    <span class="material-symbols-outlined">settings</span>
                </button>
                <button class="btn btn-outline-light p-0 d-flex align-items-center justify-content-center">
                    <span class="material-symbols-outlined">favorite</span>
                </button>
            </div>
            <div class="d-flex">
                <input class="w-100 border-0" type="text" id="docName" />
            </div>
        </div>
        <div class="d-flex">
            <div id="editor" class="w-100"></div>
            <div id="infoPanel" class="info-panel"></div>
        </div>
        <div class="position-sticky bottom-0 overflow-auto " style="background:white; max-height: 30vh;">
            <div id="scriptLogResultArea" class="w-100 font-monospace">
            </div>
        </div>
    </div>
}

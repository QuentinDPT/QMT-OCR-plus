@model Dictionary<string, string>
@{
    string visionEditorId = Model["visionEditorId"];
}

<script src="~/lib/konva/konva.min.js"></script>
<script src="~/js/shared/cameraKonva.js"></script>

<div id="@visionEditorId" class="h-100 w-100 background-pattern position-relative overflow-hidden" style="cursor:grab;"></div>

<div class="position-absolute overflow-hidden" style="top:0; left:0;">
    <div class="d-flex flex-column">
        <button class="btn btn-outline-light p-0">
            <span class="material-symbols-outlined">texture</span>
            <!--background-->
        </button>

        <div class="dropdown">

            <button class="btn btn-outline-light p-0 dropdown-toggle"
                    data-bs-toggle="dropdown">
                <span class="material-symbols-outlined">texture</span>
            </button>

            <div class="dropdown-menu horizontal-menu p-2">
                <button class="dropdown-item-btn btn btn-outline-secondary">
                    Light
                </button>
                <button class="dropdown-item-btn btn btn-outline-secondary">
                    Dark
                </button>
                <button class="dropdown-item-btn btn btn-outline-secondary">
                    checkerboard
                </button>
            </div>

        </div>

        <button class="btn btn-outline-light p-0">
            <span class="material-symbols-outlined">content_copy</span>
            <!--copy image-->
        </button>
        <button class="btn btn-outline-light p-0">
            <span class="material-symbols-outlined">content_copy</span>
            <!--copy image with overlay-->
        </button>
        <button class="btn btn-outline-light p-0">
            <span class="material-symbols-outlined">lock</span>
            <!--lock-->
        </button>
        <button class="btn btn-outline-light p-0">
            <span class="material-symbols-outlined">info</span>
            <!--parameters-->
        </button>
    </div>
</div>
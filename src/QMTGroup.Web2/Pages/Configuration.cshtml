@page
@model PrivacyModel
@{
    ViewData["Title"] = "Configuration";
}
@section Styles {
    <link href="/lib/json-viewer/jquery.json-viewer.css" type="text/css" rel="stylesheet">
}
@section Scripts {
    <script src="/lib/json-viewer/jquery.json-viewer.js"></script>

    <script>
        async function fetchData() {
            // Récupérer les données de la première requête AJAX
            const response = await fetch("https://localhost:7083/api/videostream/allcamera");
            const cameras = await response.json();

            // Initialiser la variable pour afficher les résultats
            let str = "{";

            // Parcourir chaque caméra
            for (const [key, value] of Object.entries(cameras)) {
                // Ajouter les informations de la caméra dans le champ de texte
                let v = value.replace("QMTGroup.Camera.", "").replace(".Camera", "");
                str += `"${key}":{\n"technology":"${v}",\n"key":"${key}",\n"value":\n`;

                // Récupérer les détails de chaque caméra
                const cameraDetailsResponse = await fetch(`https://localhost:7083/api/videostream/camera?cameraInstance=${key}`);
                const cameraDetails = await cameraDetailsResponse.json();

                str += JSON.stringify(cameraDetails, null, 2) + "},\n";
            }

            str = str.slice(0, -2) + "}";

            $('#json-renderer').jsonViewer(JSON.parse(str), {collapsed: true, rootCollapsable: false});
        }

        addEventListener("load", function(){
            fetchData();
        });
    </script>
}

<h1>@ViewData["Title"]</h1>


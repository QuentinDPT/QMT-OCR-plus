<Page x:Class="QMTGroup.UI.Components.Configure"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QMTGroup.UI.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Configure">

    <Grid>
        <Button x:Name="BtnStartCamera" Content="Démarer la camera" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="BtnStartCamera_Click"/>
        <Button x:Name="BtnAddFilter" Content="Appliquer un filtre" HorizontalAlignment="Left" Margin="12,35,0,0" VerticalAlignment="Top" Click="BtnAddFilter_Click"/>
        <Button x:Name="BtnFillMode" Content="Changer l'affichage" HorizontalAlignment="Left" Margin="12,60,0,0" VerticalAlignment="Top" Click="BtnFillMode_Click"/>

    </Grid>
</Page>
